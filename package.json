{
  "name": "toan-lang-sen",
  "private": true,
  "version": "0.1.0",
  "description": "Toán Làng Sen - web game toán tiểu học (MVP Lớp 1), zero dependency",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:e2e:farm": "node scripts/e2e-farm.mjs",
    "verify": "node --test \"tests/*.test.mjs\" && node scripts/verify-content.mjs"
  }
}
